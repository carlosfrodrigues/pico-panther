--title

function title_update()
	if flr(time() * 4) % 2 == 0 then
		moon_sprite=127
 else
		moon_sprite=163
 end

	if btnp(🅾️) then
		gamestate="game"
		music(0)
	end
end

function draw_title()
	spr(moon_sprite, 126*8, 62*8)
	print("press action",
			120*8, 507, 7)
	camera(896,384)
end
-->8
--map_anims

function map_anims_update()
	for a in all(map_anims) do
		if not player.dying
		and a.evil
		and collide_tile_entity(a,player) then
			music(-1)
			sfx(3)
			if player.landed then
				player.dying=true
				player.anim=time()
				player.sp=17
			else
				if not player.pending_death then
					player.pending_death=true
					player.dx=0
					player.dy=0
					player.jumping = false
					player.falling = true
				end
			end
		end
		
		if a.jump and collide_tile_entity(a,player) then
			player.jump_power=1.6
			player.jump_timer=time()+10
			del(map_anims, a)
		end
		
		if a.flag and collide_tile_entity(a,player) then
			score+=10
			sfx(24)
			del(map_anims, a)
		end
		
		if a.door and collide_tile_entity(a,player) then
			sfx(2)
			player.x=0
			player.y=62*8
		end
	
		if a.ending 
		and collide_tile_entity(a,player)
		and gamestate!="end" then
			music(8)
			gamestate="end"
		end
		
		if a.psy and collide_tile_entity(a,player) then
			player.drugs_timer=time()+20
			player.jump_power=2.5
			player.jump_timer=time()+20
			player.x=123*8
			player.y=45*8
			player.drugs=true
			music(4)
			del(map_anims, a)
		end
		
		if time() - a.anim > 0.2 then
			a.anim=time()
			a.i+=1
			if a.i > #a.sps then
				a.i=1
			end
		end
	end
end

function collide_tile_entity(tile, ent)
	local tx=tile.mx*8+1
	local ty=tile.my*8

	local tw=6
	local th=8

	local ex=ent.x+1
	local ey=ent.y
	local ew=ent.w-2
	local eh=ent.h

	return ex<tx+tw
	and ex+ew>tx
	and ey<ty+th
	and ey+eh>ty
end


function draw_map_anims()
	for a in all(map_anims) do
		spr(
			a.sps[a.i],
			a.mx*8,
			a.my*8
		)
	end
end
-->8
--enemies

function enemies_update()
	for e in all(enemies) do
		if player.punching
		and (collide(player, e) or punch_collide(player, e)) then
			sfx(0)
			e.dying=true
			e.dy=-2
			e.dx=player.flp and -1.5 or 1.5
			score+=1
		elseif not player.dying
		and not player.punching
		and not e.dying
		and collide(player, e) then
			music(-1)
			sfx(3)
			if player.landed then
				player.dying=true
				player.anim=time()
				player.sp=17
			else
				if not player.pending_death then
					player.pending_death=true
					player.dx=0
					player.dy=0
					player.jumping = false
					player.falling = true
				end
			end
		end
		if e.dying then
			e.dy+=0.3
			e.x+=e.dx
			e.y+=e.dy

			if e.y > cam_y + 140 then
				del(enemies, e)
			end
		else
			if e.walk then
				e.x+=e.dx
				e.walked+=abs(e.dx)
				if e.walked>=e.walk*8 then
					e.walked=0
					e.dx=-e.dx
					e.flp=not e.flp
				end
			elseif e.stationary then
				e.waited+=1
				if e.waited>e.wait*8 then
					e.flp=not e.flp
					e.waited=0
				end
			else
					e.x+=e.dx
			end
			
			-- colission
			if collide_map(e,"left",1) then
				e.dx=abs(e.dx)
				e.flp=true
			elseif collide_map(e,"right",1) then
				e.dx=-abs(e.dx)
				e.flp=false
			end

			-- animation
			if time() - e.anim > 0.2 then
				e.anim=time()
				e.sp+=1
				if e.sp > #e.sps then
					e.sp=1
				end
			end
		end
	end
	
	if (player.y<=31*8
	and player.y>=24*8)
	and (player.x<=43*8
	and player.x>=40*8)
	and bullet then
		sfx(25)
		add(enemies, {
			x=24*8,
			y=29*8,
			w=8, h=8,
			dx=2.5,
			flp=false,
			sps={105},
			sp=105,
			anim=0,
			walk=400,
			walked=0,
			dying=false
		})
		add(enemies, {
			x=21*8,
			y=30*8,
			w=8, h=8,
			dx=2.2,
			flp=false,
			sps={105},
			sp=105,
			anim=0,
			walk=400,
			walked=0,
			dying=false
		})
		bullet=false
	end
end


function draw_enemies()
	for e in all(enemies) do
		spr(e.sps[e.sp], e.x, e.y, 1, 1, e.flp)
	end
end

function collide(a, b)
	local ax=a.x+1
	local ay=a.y
	local aw=a.w-2
	local ah=a.h
	local bx=b.x+1
	local by=b.y
	local bw=b.w-2
	local bh=b.h

	return ax<bx+bw
	and ax+aw>bx
	and ay<by+bh
	and ay+ah>by
end

function punch_collide(a, b)
	local ax
	local ay=a.y+1
	local aw=2
	local ah=a.h-2
	local bx=b.x+1
	local by=b.y
	local bw=b.w-2
	local bh=b.h

	if a.flp then
		ax=a.x-1
	else
		ax=a.x+a.w-1
	end

	return ax<bx+bw
	and ax+aw>bx
	and ay<by+bh
	and ay+ah>by
end
