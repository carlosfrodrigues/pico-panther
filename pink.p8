--update and draw
function _update()
	if gamestate=="title" then
		title_update()
	elseif gamestate=="game" then
		player_update()
		enemies_update()
		map_anims_update()
		player_animate()
		update_break_blocks()
		startcamera()
		update_sparks()
	elseif gamestate=="end" then
		map_anims_update()
	end
	
	if (player.dying 
	and btnp(🅾️) 
	and player.sp>18)
	or (gamestate=="end"
	and btnp(🅾️))  then
		reload(0x1000, 0x1000, 0x2000)
		_init()
		gamestate = "title"
		return
	end
end

function _draw()
	cls()
	map(0,0)
	if gamestate=="title" then
		draw_title()
	elseif gamestate=="game" then
		show_score()
		if player.dying and player.sp>18 then
			print("press 'o' button to restart",
			cam_x+10, cam_y+60, 7)
		end
		spr(player.sp, player.x, player.y,1,1,player.flp)
		draw_enemies()
		draw_map_anims()
		draw_sparks()
	elseif gamestate=="end" then
		print("thanks for playing!",
			115*8, 58*8, 7)
		print("this game was developed by carlos rodrigues",
			116*8, 60*8, 7)
		print("by carlos rodrigues",
			116*8, 61*8, 12)
	end
end

function startcamera()
	cam_x=player.x-64+(player.w/2)
	
	cam_y=128*(player.y\128)
	
	if cam_x<map_start then
		cam_x=map_start
	end
	if cam_x>map_end-128 then
		cam_x=map_end-128
	end
	camera(cam_x,cam_y)
end

function show_score()
	print("score:" .. score,
			cam_x, cam_y, 7)
end
-->8
--collisions
function collide_map(obj, aim, flag)
	--obj = table needs x, y, w, h	
	local x=obj.x	local y=obj.y
	local w=obj.w local h=obj.h
	
	local x1=0	local y1=0
	local x2=0 local y2=0
	
	if aim=="left" then
		x1=x-1	y1=y
		x2=x			y2=y+h-1
	elseif aim=="right" then
		x1=x+w-1			y1=y
		x2=x+w					y2=y+h-1
	elseif aim=="up" then
		x1=x+2		y1=y-1
		x2=x+w-3	y2=y
	elseif aim=="down" then
		x1=x+2	y1=y+h
		x2=x+w-3	y2=y+h
	end

 --pixels to tiles
	x1/=8	y1/=8
	x2/=8	y2/=8
	
	if fget(mget(x1,y1), flag)
	or fget(mget(x1,y2), flag)
	or fget(mget(x2,y1), flag)
	or fget(mget(x2,y2), flag) then
		return true
	else
		return false
	end
end
-->8
--player

function player_update()
	
	if player.dying then
		return
	end
	
	if player.drugs and
	time()>player.drugs_timer then
		player.drugs=false
		player.x=54*8
		player.y=27*8
		music(0)
	end
	
	if player.y > 522 then
		music(-1)
		sfx(3)
		player.sp=17
		player.dying = true
	end
	
	if collide_map(player, "down",2) then
		friction=0.50
	elseif collide_map(player, "down",3) then
		friction=1.2
		--player.max_dx=3
		--player.boost=2
	else
		friction=0.85
	end
	player.dy+=gravity
	player.dx*=friction

	if (collide_map(player,"left", 7) 
	or collide_map(player,"right", 7))
	and player.punching==true
	then	
		local tx, ty

		if player.flp then
			tx = flr((player.x - 1) / 8)
		else
			tx = flr((player.x + player.w) / 8)
		end
			ty = flr((player.y) / 8)
			local tile = mget(tx, ty)
		if tile!=0
		and fget(tile,7)
		and not is_breaking(tx, ty) then
			sfx(4)
			add(break_blocks, {
				mx = tx,
				my = ty,
				sp = 76,
				t = time()
			})
			mset(tx, ty, 76)
		end
	end
	
	if btn(⬅️)
	and not player.pending_death then
		player.dx-=player.acc
		player.running=true
		player.flp=true
	end
	if btn(➡️)
	and not player.pending_death then
		player.dx+=player.acc
		player.running=true
		player.flp=false
	end	
	
	if player.running
	and not btn(⬅️)
	and not btn(➡️)
	and not player.falling
	and not player.jumping then
		player.running=false
		player.sliding=true
	end
	
	if btnp(❎)
	and not player.pending_death
	and player.landed then
		sfx(1)
		player.dy-=player.boost*player.jump_power
		player.landed=false
	end
	if btnp(🅾️) 
	and not player.punching
	and not player.dying
	and not player.pending_death
	and not player.punch_lock then
		player.punching=true
		player.sp=8
		player.anim = time()
		player.punch_lock=true
	end
	
	if not btn(🅾️) then
		player.punch_lock = false
	end

	if player.jump_timer>0
	and time()>player.jump_timer then
		player.jump_power=1
		player.jump_timer=0
	end
	if player.dy<0 and player.jump_timer>0 then
		add(sparks,{
			x=player.x+rnd(player.w),
			y=player.y+player.h,
			dy=rnd(0.5),
			t=time()
		})
	end
	if player.dy>0 then
		player.falling=true
		player.landed=false
		player.jumping=false
		
		player.dy=limit_speed(player.dy,player.max_dy)
		if collide_map(player,"down", 0) then	
			player.landed=true
			player.falling=false
			player.dy=0
			player.y-=((player.y+player.h+1)%8)-1
			
			if player.pending_death then
				player.pending_death=false
				player.dying=true
				player.anim=time()
				player.sp=17
			end
		end
	
	elseif player.dy<0 then
		player.jumping=true
		if collide_map(player,"up",1) then
			player.dy=0
	 end
	end

	if player.dx<0 then
		player.dx=limit_speed(player.dx, player.max_dx)
		if collide_map(player,"left",1) then
			player.dx=0
		end
	elseif player.dx>0 then
		player.dx=limit_speed(player.dx, player.max_dx)
		if collide_map(player, "right",1) then
			player.dx=0
		end
	end
	
	if player.sliding then
		if abs(player.dx)<.2
		or player.running then
			player.dx=0
			player.sliding=false
		end
	end
	
	player.x+=player.dx
	player.y+=player.dy

	if player.x<map_start then
		player.x=map_start
	end
	if player.x>map_end-player.w then
		player.x=map_end-player.w
	end
end

function player_animate()
	if player.dying then
		if time() - player.anim > 0.12 then
			player.anim = time()
			player.sp += 1

			if player.sp > 25 then
				player.sp = 22
			end
		end
		return
	end

	if player.punching then
		if time()-player.anim>.08 then
			player.anim=time()
			player.sp+=1
			if player.sp>11 then
				player.punching=false
				if player.running then
					player.sp=3
				else
					player.sp=1
				end
			end
		end
	elseif player.jumping then
		player.sp=5
	elseif player.falling then
		player.sp=6
	elseif player.sliding then
		player.sp=7
	elseif player.running then
		if time()-player.anim>.1 then
			player.anim=time()
			player.sp+=1
			if player.sp>4 then
				player.sp=3
			end
		end
	else
		if time()-player.anim>.3 then
			player.anim=time()
			player.sp+=1
			if player.sp>2 then
				player.sp=1
			end
		end
	end
end

function limit_speed(num, maximum)
	return mid(-maximum, num, maximum)
end

function is_breaking(x, y)
	for b in all(break_blocks) do
		if b.mx == x and b.my == y then
			return true
		end
	end
	return false
end

function update_sparks()
	for s in all(sparks) do
		s.y+=s.dy
		if time()-s.t>0.3 then
			del(sparks,s)
		end
	end
end

function draw_sparks()
	for s in all(sparks) do
		pset(s.x, s.y, 10) -- amarelinho
	end
end
-->8
--blocks

function update_break_blocks()
	for b in all(break_blocks) do
		if time() - b.t > 0.1 then
			b.t = time()
			b.sp += 1

			if b.sp > 79 then
				if(player.y > 47*8) then
					mset(b.mx, b.my, 104)
				else
					mset(b.mx, b.my, 0)
				end
				del(break_blocks, b)
				score+=1
			else
				mset(b.mx, b.my, b.sp)
			end
		end
	end
end
